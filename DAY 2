11.PRIME NUMBERS
#include <stdio.h>
int main()
{
    int n,i,c=0;
    scanf("%d",&n);//22
    if(n==1)
    {
        printf("Neither prime nor composite number");
        return 0;
    }
    for(int i=2;i<n/2;i++)
    {
        if(n%i==0)
        {
            c++;
            printf("Not a prime number");
            break;
        }        
    }
    if(c==0)
    printf("Number is a prime number");
}

12.COUNT OF NUMBERS
#include <stdio.h>
int main()
{
    int n,c=0;
    scanf("%d",&n);//256
    while(n!=0)//0!-0
    {
        n=n/10;//2/10=10
        c++;//c=3
    }
    printf("%d",c);
}
13.SUM OF DIGITS OF A NUMBERS
#include <stdio.h>
int main()
{
    int n,sum=0,d;
    scanf("%d",&n);
    while(n!=0)
    {
        d=n%10;
        sum=sum+d;
        n=n/10;
    }
    printf("%d",sum);
}
